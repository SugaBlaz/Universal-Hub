				for _, p in ipairs(plr:GetPlayers()) do createHitbox(p) end

				globalConns.Added = plrs.PlayerAdded:Connect(createHitbox)
				globalConns.Removed = plrs.PlayerRemoving:Connect(removeHitbox)

				-- Keep visuals updated (Colors/Size sync)
				hbUpdateConn = RS.RenderStepped:Connect(function()
					for player, data in pairs(hitboxFolder) do
						if data.Box and data.Part and data.Part.Parent then
							data.Box.Color3 = player.TeamColor.Color
							data.Box.Size = data.Part.Size -- Visually matches expanded size

							-- Expand Hitbox Logic
							if hbExpanderValue > 0 then
								data.Part.Size = Vector3.new(hbExpanderValue, hbExpanderValue, hbExpanderValue)
								data.Part.CanCollide = false
							end
						end
					end
				end)
			else
				-- Disable & Cleanup
				if hbUpdateConn then hbUpdateConn:Disconnect() hbUpdateConn = nil end
				if globalConns.Added then globalConns.Added:Disconnect() end
				if globalConns.Removed then globalConns.Removed:Disconnect() end

				for _, p in ipairs(plrs:GetPlayers()) do
					removeHitbox(p)
				end
			end
		end
	})

