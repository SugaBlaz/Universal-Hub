	local hitboxFolder = {} -- Stores player data
	local globalConns = {} -- Stores PlayerAdded/Removing connections
	local originalSizes = {}
	local hbExpanderValue = 0
	local hitboxEnabled = false
	local hbUpdateConn -- The RenderStepped connection

	-- Helper: Completely cleans up a player's hitbox and visuals
	local function removeHitbox(player)
		local data = hitboxFolder[player]
		if data then
			if data.Box then data.Box:Destroy() end
			if data.CharConn then data.CharConn:Disconnect() end
			hitboxFolder[player] = nil
		end

		-- Reset the physical Part size
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root and originalSizes[player] then
			root.Size = originalSizes[player]
			root.Transparency = 0 -- Reset transparency if changed by expander
			root.CanCollide = true
		end
	end

	-- Helper: Creates the visual and physical hitbox
	local function createHitbox(player)
		if player == plrs.LocalPlayer then return end
		removeHitbox(player) -- Clean start

		local function setup(character)
			local root = character:WaitForChild("HumanoidRootPart", 10)
			if not root then return end

			if not originalSizes[player] then
				originalSizes[player] = root.Size
			end

			-- Create Visual Box
			local adornment = Instance.new("BoxHandleAdornment")
			adornment.Name = "HitboxView"
			adornment.Adornee = root
			adornment.AlwaysOnTop = true
			adornment.ZIndex = 10
			adornment.Transparency = 0.5
			adornment.Color3 = player.TeamColor.Color
			adornment.Size = root.Size
			adornment.Parent = root

			-- Store references without overwriting the connection
			if hitboxFolder[player] then
				hitboxFolder[player].Box = adornment
				hitboxFolder[player].Part = root
			end
		end

		local conn = player.CharacterAdded:Connect(setup)
		hitboxFolder[player] = { CharConn = conn } -- Initialize table with connection

		if player.Character then setup(player.Character) end
	end

