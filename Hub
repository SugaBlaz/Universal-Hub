function safeloadstring(url)
    local code = game:HttpGet(url)
    local func, errorMessage = loadstring(code)
    
    if func then
        print("Script compiled! Executing...")
        return func()
    else
        warn("LOADSTRING FAILED: " .. tostring(errorMessage))
        return nil
    end
end

