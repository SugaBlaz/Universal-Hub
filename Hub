			local currentId = game.JobId

			local servers = GetServerList(placeId, nil, "Asc")

			if servers and servers.data then
				local targetServer = nil
				for _, server in pairs(servers.data) do
					if server.id ~= currentId and server.playing > 0 and server.playing < server.maxPlayers then
						targetServer = server
						break
					end
				end

				if targetServer then
					TPS:TeleportToPlaceInstance(placeId, targetServer.id, plr)
				else
					ui:Notify({
						Title = "Failed",
						Text = "Hop Failed. Could not find a server.",
						Duration = 3,
						StartPosition = UDim2.new(1, 0, 0.776, 0),
						EndPosition = UDim2.new(0.724, 0, 0.776, 0),
						TweenTime = 0.5
					})
				end
			end
		end,
	})

	ui:AddButton({
		Text = "Server Hop",
		Callback = function()
			local placeId = game.PlaceId
			local currentId = game.JobId

			local servers = GetServerList(placeId, nil, "Desc")

			if servers and servers.data then
				local possibleServers = {}
				for _, server in pairs(servers.data) do
					if server.id ~= currentId and server.playing < server.maxPlayers then
						table.insert(possibleServers, server.id)
					end
				end

				if #possibleServers > 0 then
					local randomId = possibleServers[math.random(1, #possibleServers)]
					TPS:TeleportToPlaceInstance(placeId, randomId, plr)
				else
					ui:Notify({
						Title = "Failed",
						Text = "Hop Failed. Could not find a server.",
						Duration = 3,
						StartPosition = UDim2.new(1, 0, 0.776, 0),
						EndPosition = UDim2.new(0.724, 0, 0.776, 0),
						TweenTime = 0.5
					})
				end
			end
		end,
	})

	ui:AddButton({
		Text = "Rejoin server",
		Callback = function()
			local place = game.PlaceId
			local jobId = game.JobId
			local delay = 2

			task.delay(delay, function()
				TPS:TeleportToPlaceInstance(place, jobId, plr)
			end)
		end,
	})

	ui:AddSeparator()

	ui:AddSection("Executables")

	ui:AddButton({
		Text = "Suga's Imported Script Hub",
		TextSize = 9,
		Callback = function()
			loadstring(game:HttpGet("https://raw.githubusercontent.com/SugaBlaz/Universal-Hub/refs/heads/main/Script%20Hub%20(Open%20Source)"))()
		end,
	})
	
	ui:AddButton({
		Text = "Open Server List",
		Callback = function()
			initServerList()
		end,
	})

	ui:AddSeparator()

	ui:AddSection("Ui Controls")

	ui:AddButton({
		Text = "Destroy Ui",
		Callback = function()
			ui:Destroy()
			script:Destroy()
		end
	})

	ui:AddButton({
		Text = "Restart Ui",
		Callback = function()
			enteredkey = false
			ui:Destroy()
			task.wait(.5)
			loadstring(game:HttpGet("https://raw.githubusercontent.com/SugaBlaz/Universal-Hub/refs/heads/main/Hub"))()
			script:Destroy()
		end
	})

	ui:AddSeparator()

	ui:AddSection("Credits")

	ui:AddLabel("Hmmm5650")

	ui:AddSeparator()
	
	ui:AddLabel("Made By SugaBlaz")
	ui:AddLabel("Version 0.9")
	ui:AddLabel("Running "..ui:GetVersion())

	game:GetService("UserInputService").InputBegan:Connect(function(inp, gpe)
		if gpe then return end

		if inp.KeyCode == Enum.KeyCode.F2 then
			enteredkey = false
			doneloading = false
			ui:Destroy()
			task.wait(.5)
			loadstring(game:HttpGet("https://raw.githubusercontent.com/SugaBlaz/Universal-Hub/refs/heads/main/Hub"))()
			script:Destroy()
		end
			
		if inp.KeyCode == Enum.KeyCode.F1 then
			doneloading = false
			enteredkey = false
			ui:Destroy()
			task.wait(.5)
			script:Destroy()
		end
	end)
